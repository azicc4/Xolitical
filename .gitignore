# Per-user config (copy config.example.json -> config.json)
config.json

# The vault is local-only: media, the index (.xolitical/), event and category
# notes, papers and Obsidian settings never enter git. The repo holds only the
# viewer program; "Initialize vault here" on the start screen creates a fresh
# vault (Home, views, gallery stylesheet) on any machine.
vault/

# Atomic-write temp files
*.tmp
*.partial

# Legacy Phase 1 inbox, if you still have one locally
unsorted/

# OS / editor junk
Thumbs.db
.DS_Store
desktop.ini
__pycache__/
*.pyc
