properties:
  note.file_count:
    displayName: Files
  note.date:
    displayName: Date
  note.added_by:
    displayName: Added by
views:
  - type: cards
    name: Gallery
    image: note.cover
    filters:
      and:
        - file.inFolder("Events")
    order:
      - file.name
      - note.categories
      - note.file_count
    sort:
      - property: note.date
        direction: DESC
  - type: table
    name: Events
    filters:
      and:
        - file.inFolder("Events")
    order:
      - file.name
      - note.date
      - note.categories
      - note.subcategories
      - note.tags
      - note.file_count
      - note.accounts
      - note.added_by
    sort:
      - property: note.date
        direction: DESC
  - type: table
    name: Categories
    filters:
      and:
        - file.inFolder("Categories")
    order:
      - file.name
      - note.parent
  - type: table
    name: Needs review
    filters:
      and:
        - file.inFolder("Events")
        - file.hasTag("needs-review")
    order:
      - file.name
      - note.date
      - note.categories
      - note.added_by
  - type: table
    name: Papers
    filters:
      and:
        - file.inFolder("Papers")
    order:
      - file.name
      - note.authors
      - note.year
      - note.added_by
